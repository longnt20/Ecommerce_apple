# Optional local configuration for P0. Never copy application DB credentials here.
# Default suite runs with every Laravel database connection disabled.
P0_DB_MODE=disabled

# Enable mysql only after provisioning and checking a dedicated existing schema.
# The test runner never creates/imports/migrates a database or grants privileges.
# Explicit P0/P1 provisioning (uses admin connection in .env only for setup):
# php tests/Support/prepare-database-sandbox.php --provision-from-env
# This creates an isolated schema and DML-only account, then writes ignored .env.testing.
P0_TEST_DB_HOST=127.0.0.1
P0_TEST_DB_PORT=3306
P0_TEST_DB_DATABASE=apple_project_p0_tests
P0_TEST_DB_USERNAME=apple_project_p0_test
P0_TEST_DB_PASSWORD=
